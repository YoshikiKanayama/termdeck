#!/bin/zsh
# termdeck のリスト UI（2026-08-03）— deck 画面の左上ペインで動く
#
# fzf のループ。選ぶと deck open が呼ばれて右上に出る。
# フックが状態を更新すると ctrl-r（reload）がこのペインに送られ、表示が追従する。
set -u

DECK_ROOT="${0:A:h:h}"
DECK="$DECK_ROOT/bin/deck"

# fzf が無いときに exit すると respawn ループになるため、シェルに落として留まる
command -v fzf >/dev/null 2>&1 || { print "fzf が必要です: brew install fzf（入れたら deck-list で再開）" >&2; exec zsh }

HEADER=$'Enter/ダブルクリック: 開く   ^N: 新規   ^K: 削除\n^S: 再起動後に復元する/しない   ^R: 更新'

# ── 状態の見張り ──
# フックが飛ぶのは「プロンプト送信 / 応答完了 / 通知」の瞬間だけなので、
# 「承認に答えて作業が再開した」のような遷移は誰も知らせてくれない。
# 一覧の中身が実際に変わったときだけ reload（^R）を送って追随させる。
# 表示が変わらない間は何も送らないので、カーソルはむやみに動かない
tmux_() {
  if [[ -n "${DECK_TMUX_SOCKET:-}" ]]; then command tmux -L "$DECK_TMUX_SOCKET" "$@"
  else command tmux "$@"; fi
}

if [[ -n "${TMUX_PANE:-}" ]]; then
  parent=$$
  (
    prev=$(zsh "$DECK" ls 2>/dev/null)
    while kill -0 $parent 2>/dev/null; do
      sleep "${DECK_WATCH_INTERVAL:-3}"
      # 誰も見ていない（デタッチ中）なら回さない
      [[ "$(tmux_ display -p -t "$TMUX_PANE" '#{session_attached}' 2>/dev/null)" == 0 ]] && continue
      cur=$(zsh "$DECK" ls 2>/dev/null)
      [[ "$cur" == "$prev" ]] && continue
      prev="$cur"
      tmux_ send-keys -t "$TMUX_PANE" C-r 2>/dev/null
    done
  ) &
  watcher=$!
  trap 'kill $watcher 2>/dev/null' EXIT INT TERM
fi

while true; do
  out=$(zsh "$DECK" ls 2>/dev/null | fzf \
    --ansi --delimiter '\t' --with-nth 2 --nth 2 \
    --layout=reverse --no-sort --info=hidden --no-separator --track \
    --header "$HEADER" --prompt='termdeck > ' \
    --expect=ctrl-n,ctrl-s,ctrl-k \
    --bind "ctrl-r:reload(zsh ${(q)DECK} ls 2>/dev/null)" \
    --preview "zsh ${(q)DECK} status --term {1}" \
    --preview-window=down,45%,wrap) || true

  key="${out%%$'\n'*}"
  sel="${out#*$'\n'}"
  [[ "$sel" == "$out" ]] && sel=""   # 選択行なし（一覧が空・Esc など）
  id="${sel%%$'\t'*}"

  case "$key" in
    ctrl-n)
      zsh "$DECK" new || true
      ;;
    ctrl-s)
      if [[ -n "$id" ]]; then
        if [[ "$(zsh "$DECK" status --resume-flag "$id")" == "true" ]]; then
          zsh "$DECK" stop "$id"
        else
          zsh "$DECK" keep "$id"
        fi
        sleep 0.7   # メッセージを読める程度に見せる
      fi
      ;;
    ctrl-k)
      [[ -n "$id" ]] && zsh "$DECK" kill "$id"
      ;;
    *)
      [[ -n "$id" ]] && zsh "$DECK" open "$id"
      ;;
  esac
  sleep 0.1   # Esc 連打などでループが暴走しないように
done
